{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm types:*)",
      "Bash(pnpm install --ignore-scripts)",
      "Bash(pnpm install --frozen-lockfile --ignore-scripts)",
      "Bash(pnpm install --lockfile-only --no-frozen-lockfile --ignore-scripts)",
      "Bash(pnpm list:*)",
      "Bash(pnpm conformance:*)",
      "Bash(pnpm --filter @hypequery/clickhouse build:*)",
      "Bash(pnpm --filter @hypequery/clickhouse test:*)",
      "Bash(pnpm --filter @hypequery/datasets build:*)",
      "Bash(pnpm --filter @hypequery/datasets test:*)",
      "Bash(pnpm --filter @hypequery/serve build:*)",
      "Bash(pnpm --filter @hypequery/serve test:*)",
      "Bash(pnpm --filter @hypequery/react build:*)",
      "Bash(pnpm --filter @hypequery/react test:*)",
      "Bash(pnpm --filter @hypequery/cli build:*)",
      "Bash(pnpm --filter @hypequery/cli test:*)",
      "Bash(pnpm --filter @hypequery/mcp build:*)",
      "Bash(pnpm --filter @hypequery/mcp test:*)",
      "Bash(pnpm --filter @hypequery/protocol build:*)",
      "Bash(pnpm --filter @hypequery/protocol test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(wc:*)"
    ]
  }
}
