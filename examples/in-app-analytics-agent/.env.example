# The signing key's private key JSON, exactly as hypequery Cloud showed it once
# (Settings → Customer access → Signing keys for in-app agents). It carries the
# project (hq_project) and the customer endpoint (hq_endpoint). Keep it secret.
HYPEQUERY_AGENT_KEY=

# The permission set end users act with. Default: customers.
HYPEQUERY_PERMISSION_SET=customers

# The chat model, as <provider>:<model id>. Default: anthropic:claude-opus-5-5.
AI_MODEL=anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=   # with AI_MODEL=openai:<model id>

# Where the hypequery tools run: cloud (default) uses the signing key above and
# your Cloud project's tenant endpoint; self-hosted runs them in this app's own
# backend against your ClickHouse, with no Cloud and no key.
HYPEQUERY_MODE=cloud

# Self-hosted only: your ClickHouse. Defaults match examples/_seed.
# CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=hypequery
# CLICKHOUSE_DATABASE=hypequery_examples
