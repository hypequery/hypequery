{
  "name": "@hypequery-examples/materialized-view-rollups",
  "version": "0.1.5",
  "private": true,
  "description": "Incremental and refreshable ClickHouse materialized views side by side, queried through a hypequery dataset",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "setup": "npm run build && node dist/setup.js",
    "query": "npm run build && node dist/query.js",
    "dev": "npm run setup && node dist/query.js",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "@clickhouse/client": "^1.25.0",
    "@hypequery/clickhouse": "workspace:*",
    "@hypequery/datasets": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
