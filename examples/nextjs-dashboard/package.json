{
  "name": "@hypequery-examples/nextjs-dashboard",
  "version": "0.1.1",
  "private": true,
  "description": "Next.js dashboard over ClickHouse with typed hypequery datasets, serve endpoints and React hooks with cross-filtering",
  "type": "module",
  "scripts": {
    "manifest": "hypequery generate:manifest analytics/api.ts --output analytics/hypequery-manifest.json",
    "dev": "next dev",
    "prebuild": "npm run manifest",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "@hypequery/clickhouse": "workspace:*",
    "@hypequery/datasets": "workspace:*",
    "@hypequery/react": "workspace:*",
    "@hypequery/serve": "workspace:*",
    "@tanstack/react-query": "^5.105.1",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@hypequery/cli": "workspace:*",
    "@types/node": "^22.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
