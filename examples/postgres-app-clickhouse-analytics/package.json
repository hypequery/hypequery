{
  "name": "@hypequery-examples/postgres-app-clickhouse-analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Keep your app's accounts in Postgres with Drizzle, serve usage analytics from ClickHouse with hypequery, and join them by account id in the app",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "pnpm build && node dist/src/index.js",
    "start": "node dist/src/index.js",
    "db:seed": "pnpm build && node dist/db/seed-cli.js",
    "bench": "pnpm build && node dist/scripts/bench.js",
    "test": "pnpm build && vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@hono/node-server": "^2.0.5",
    "@hypequery/clickhouse": "workspace:*",
    "@hypequery/datasets": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.15.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
