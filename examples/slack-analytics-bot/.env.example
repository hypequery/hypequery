# Slack. Run `pnpm manifest` (or `npx hypequery slack init --socket`), create the
# app from the manifest at https://api.slack.com/apps?new_app=1 and install it.
SLACK_BOT_TOKEN=
# Socket Mode (no public URL): an app-level token with connections:write.
SLACK_APP_TOKEN=
# Or HTTP mode: leave SLACK_APP_TOKEN empty and set the Signing Secret.
# SLACK_SIGNING_SECRET=
# PORT=3000

# Who may ask, and each channel's ceiling: <slack id>:<analyst|admin>, comma-separated.
# An admin asking in an analyst channel gets the answer privately.
SLACK_MEMBERS=U0123ADMIN:admin,U0456ANALYST:analyst
SLACK_CHANNELS=C0PRODUCT:analyst,C0LEADERS:admin

# The chat model, as <provider>:<model id>. Default: anthropic:claude-opus-5-5.
AI_MODEL=anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=

# Your ClickHouse. Defaults match examples/_seed.
# CLICKHOUSE_URL=http://localhost:8123
# CLICKHOUSE_USERNAME=default
# CLICKHOUSE_PASSWORD=hypequery
# CLICKHOUSE_DATABASE=hypequery_examples
