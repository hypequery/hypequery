{
  "name": "hypequery-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "workspaces": [
    "packages/cli",
    "packages/clickhouse",
    "packages/datasets",
    "packages/mcp-server",
    "packages/protocol",
    "packages/react",
    "packages/serve",
    "packages/tsconfig"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test --filter='@hypequery/*'",
    "types": "turbo run types",
    "test:integration": "cd packages/clickhouse && npm run test:integration",
    "lint": "turbo run lint --filter='@hypequery/*'",
    "start": "turbo run dev",
    "docs:api": "cd packages/clickhouse && npm run docs:api",
    "docs:mdx": "cd packages/clickhouse && npm run docs:mdx",
    "fix:mdx": "node packages/clickhouse/scripts/fix-mdx-frontmatter.js",
    "smoke:cli": "bash scripts/smoke-cli.sh",
    "smoke:cli-chdb": "bash scripts/smoke-cli-chdb.sh",
    "smoke:serve-adapters": "bash scripts/smoke-serve-adapters.sh",
    "smoke:semantic-consumer": "bash scripts/smoke-semantic-consumer.sh",
    "smoke:docs-snippets": "bash scripts/smoke-docs-snippets.sh",
    "smoke:consumers": "pnpm smoke:cli && pnpm smoke:cli-chdb && pnpm smoke:serve-adapters && pnpm smoke:semantic-consumer && pnpm smoke:docs-snippets",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@type-challenges/utils": "^0.1.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^8.0.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@modelcontextprotocol/sdk>ajv": "^8.17.1",
      "ajv-formats@3.0.1>ajv": "^8.17.1",
      "ajv": "^6.14.0",
      "@babel/core": "^7.29.6",
      "brace-expansion": "^2.0.3",
      "esbuild": "^0.25.0",
      "fast-uri": "^3.1.2",
      "flatted": "^3.4.2",
      "glob": "^10.5.0",
      "hono": "^4.12.25",
      "js-yaml@<4": "^3.15.0",
      "js-yaml@>=4": "^4.2.0",
      "linkify-it": "^5.0.1",
      "lodash": "^4.18.0",
      "markdown-it": "^14.2.0",
      "minimatch": "^10.2.3",
      "picomatch": "^4.0.4",
      "postcss": "^8.5.10",
      "rollup": "^4.59.0",
      "shell-quote": "^1.8.4",
      "vite": "^6.4.3",
      "ws": "^8.21.0",
      "yaml": "^2.8.3"
    }
  }
}
