{
  "name": "@hypequery/agent",
  "version": "0.0.0",
  "description": "Put a hypequery Cloud project's tenant-safe analytics in your own agent: mint end-user tokens locally",
  "keywords": [
    "hypequery",
    "agent",
    "mcp",
    "jwt",
    "multi-tenant",
    "analytics"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"type-tests/**/*.ts\"",
    "test": "npm run test:types && npm run test:unit",
    "test:unit": "vitest run",
    "test:types": "tsc --project tsconfig.type-tests.json",
    "types": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jose": "^6.2.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypequery/hypequery.git",
    "directory": "packages/agent"
  },
  "homepage": "https://hypequery.com",
  "bugs": {
    "url": "https://github.com/hypequery/hypequery/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
