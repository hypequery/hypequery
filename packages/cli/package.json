{
  "name": "@hypequery/cli",
  "version": "1.16.4",
  "description": "CLI for scaffolding type-safe ClickHouse analytics, semantic datasets, React manifests, and deployments",
  "keywords": [
    "clickhouse",
    "typescript",
    "analytics",
    "semantic-layer",
    "query-builder",
    "orm",
    "code-generation",
    "chdb",
    "cli"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "hypequery": "./dist/bin/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "lint": "eslint --ext .ts \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@clickhouse/client": "^1.18.3",
    "@hypequery/deployment": "workspace:*",
    "@hypequery/protocol": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "open": "^10.0.0",
    "ora": "^8.0.1",
    "prompts": "^2.4.2"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  },
  "peerDependencies": {
    "@hypequery/serve": "*"
  },
  "devDependencies": {
    "@hypequery/serve": "workspace:*",
    "@types/node": "^20.11.30",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^3.2.6",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypequery/hypequery.git",
    "directory": "packages/cli"
  },
  "homepage": "https://hypequery.com",
  "bugs": {
    "url": "https://github.com/hypequery/hypequery/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
