          },
          "filterable": true,
          "groupable": true
        }
      ],
      "measures": [
        {
          "name": "users",
          "aggregation": "merge",
          "field": "users_state",
          "filters": [],
          "stateFunction": "uniq"
        }
      ],
      "filters": [
        {
          "name": "day",
          "field": "day",
          "operators": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "notIn",
            "between",
            "like"
          ]
        }
      ],
      "relationships": [],
      "timeField": "day",
      "endpoint": {
        "access": {
          "kind": "authenticated",
          "roles": [
            "product"
          ],
          "scopes": [
            "events:read"
          ]
