    {
      "name": "invoices",
      "source": "billing.invoices",
      "tenant": {
        "kind": "required",
        "field": "tenant_id"
      },
      "dimensions": [
        {
          "name": "account_id",
          "type": "string",
          "source": {
            "kind": "column",
            "column": "account_id"
          },
          "filterable": true,
          "groupable": true
        },
        {
          "name": "amount",
          "type": "number",
          "source": {
            "kind": "column",
            "column": "amount"
          },
          "filterable": true,
          "groupable": true,
          "format": "0,0",
          "unit": "cents",
          "currency": "EUR"
        },
        {
          "name": "email",
          "type": "string",
          "source": {
            "kind": "column",
            "column": "email"
          },
          "filterable": true,
          "groupable": true,
          "sensitivity": "confidential"
        },
        {
          "name": "id",
          "type": "string",
          "source": {
            "kind": "column",
            "column": "id"
          },
          "filterable": true,
          "groupable": true
        },
        {
          "name": "issuedAt",
          "type": "timestamp",
          "source": {
            "kind": "column",
            "column": "issued_at"
          },
          "filterable": true,
          "groupable": true
        },
        {
          "name": "month",
          "type": "string",
          "source": {
            "kind": "sql-expression",
            "dialect": "clickhouse",
            "sql": "formatDateTime(issued_at, '%Y-%m')",
            "output": {
              "kind": "string"
            },
            "dependencies": [
              "issued_at"
            ]
          },
          "filterable": true,
          "groupable": true,
          "label": "Month"
        },
        {
          "name": "plan_id",
          "type": "string",
          "source": {
            "kind": "column",
            "column": "plan_id"
          },
          "filterable": true,
          "groupable": true
        },
        {
          "name": "plan_region",
          "type": "string",
          "source": {
            "kind": "column",
            "column": "plan_region"
          },
          "filterable": true,
          "groupable": true
        },
        {
          "name": "status",
          "type": "string",
          "source": {
            "kind": "column",
            "column": "status"
          },
          "filterable": true,
          "groupable": true,
          "description": "paid, open or void"
        },
        {
          "name": "tenant_id",
          "type": "string",
          "source": {
            "kind": "column",
            "column": "tenant_id"
          },
          "filterable": false,
          "groupable": true
        }
      ],
      "measures": [
        {
          "name": "invoices",
          "aggregation": "count",
          "field": "id",
          "filters": []
        },
        {
          "name": "largest",
          "aggregation": "max",
          "field": "amount",
          "filters": []
        },
        {
          "name": "latestStatus",
          "aggregation": "argMax",
          "field": "status",
          "filters": [],
          "argField": "issuedAt"
        },
        {
          "name": "median",
          "aggregation": "percentile",
          "field": "amount",
          "filters": [],
          "level": 0.5
        },
        {
          "name": "openOrPaid",
          "aggregation": "sum",
          "field": "amount",
          "filters": [
            {
              "kind": "comparison",
              "operator": "in",
              "left": {
                "kind": "reference",
                "name": "status"
              },
              "right": {
                "kind": "literal",
                "value": {
                  "$hypequery": {
                    "type": "array",
                    "version": 1,
                    "values": [
                      "open",
                      "paid"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "name": "p90",
          "aggregation": "percentile",
          "field": "amount",
          "filters": [],
          "level": 0.9
        },
        {
          "name": "revenue",
          "aggregation": "sum",
          "field": "amount",
          "filters": [
            {
              "kind": "comparison",
              "operator": "eq",
              "left": {
                "kind": "reference",
                "name": "status"
              },
              "right": {
                "kind": "literal",
                "value": "paid"
              }
            }
          ],
          "label": "Revenue"
        },
        {
          "name": "withEmail",
          "aggregation": "count",
          "field": "id",
          "filters": [
            {
              "kind": "comparison",
              "operator": "isNotNull",
              "left": {
                "kind": "reference",
                "name": "email"
              }
            }
          ]
        },
        {
          "kind": "derived",
          "name": "averageInvoice",
          "uses": [
            {
              "alias": "total",
              "measure": "revenue"
            },
            {
              "alias": "count",
              "measure": "invoices"
            }
          ],
          "expression": {
            "kind": "call",
            "function": "round",
            "args": [
              {
                "kind": "binary",
                "operator": "divide",
                "left": {
                  "kind": "reference",
                  "name": "total"
                },
                "right": {
                  "kind": "call",
                  "function": "nullIfZero",
                  "args": [
                    {
                      "kind": "reference",
                      "name": "count"
                    }
                  ]
                }
              },
              {
                "kind": "literal",
                "value": 2
              }
            ]
          },
          "label": "Average invoice"
        },
        {
          "kind": "derived",
          "name": "unpaid",
          "uses": [
            {
              "alias": "all",
              "measure": "openOrPaid"
            },
            {
              "alias": "paid",
              "measure": "revenue"
            }
          ],
          "expression": {
            "kind": "call",
            "function": "coalesce",
            "args": [
              {
                "kind": "binary",
                "operator": "subtract",
                "left": {
                  "kind": "reference",
                  "name": "all"
                },
                "right": {
                  "kind": "reference",
                  "name": "paid"
                }
              },
              {
                "kind": "literal",
                "value": 0
              }
            ]
          }
        }
      ],
      "filters": [
        {
          "name": "amount",
          "field": "amount",
          "operators": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "notIn",
            "between",
            "like"
          ],
          "label": "Amount"
        },
        {
          "name": "issuedAt",
          "field": "issuedAt",
          "operators": [
            "gte",
            "lt",
            "between"
          ]
        },
        {
          "name": "status",
          "field": "status",
          "operators": [
            "eq",
            "neq",
            "in",
            "notIn"
          ]
        }
      ],
      "relationships": [
        {
          "name": "account",
          "kind": "belongsTo",
          "target": "accounts",
          "from": "account_id",
          "to": "id",
          "queryable": true
        },
        {
          "name": "plan",
          "kind": "belongsTo",
          "target": "plans",
          "from": "plan_id",
          "to": "id",
          "keys": [
            {
              "from": "plan_id",
              "to": "id"
            },
            {
              "from": "plan_region",
              "to": "region"
            }
          ],
          "queryable": true
        }
      ],
      "timeField": "issuedAt",
      "description": "Every invoice, including credit notes (they're negative).",
      "defaults": {
        "dimensions": [
          "status"
        ],
        "timeGrain": "month"
      },
      "limits": {
        "maxDimensions": 6,
        "maxResultSize": 500
      },
      "endpoint": {
        "access": {
          "kind": "authenticated",
          "roles": [],
          "scopes": []
        },
        "tenant": {
          "kind": "required",
          "mode": "manual",
          "column": "tenant_id"
        },
        "cacheTtlMs": 60000,
        "path": "/api/analytics/datasets/invoices/query"
      }
    },
