          "source": {
            "kind": "column",
            "column": "created_at"
          },
          "filterable": true,
          "groupable": true,
          "label": "Created"
        },
        {
          "name": "id",
          "type": "string",
          "source": {
            "kind": "column",
            "column": "id"
          },
          "filterable": true,
          "groupable": true
        },
        {
          "name": "name",
          "type": "string",
          "source": {
            "kind": "column",
            "column": "name"
          },
          "filterable": true,
          "groupable": true,
          "examples": [
            "Acme",
            "Northwind"
          ]
        },
        {
          "name": "tenant_id",
          "type": "string",
          "source": {
            "kind": "column",
            "column": "tenant_id"
          },
          "filterable": false,
          "groupable": false
        }
      ],
      "measures": [
        {
          "name": "accounts",
          "aggregation": "countDistinct",
          "field": "id",
          "filters": [],
          "label": "Accounts"
        }
      ],
      "filters": [
        {
          "name": "createdAt",
          "field": "createdAt",
          "operators": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "notIn",
            "between",
            "like"
          ]
        },
        {
          "name": "id",
          "field": "id",
          "operators": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "notIn",
            "between",
            "like"
          ]
        },
        {
          "name": "name",
          "field": "name",
          "operators": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "notIn",
            "between",
            "like"
          ]
        }
