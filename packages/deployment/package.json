{
  "name": "@hypequery/deployment",
  "version": "0.1.0",
  "description": "Provider-neutral deployment verification and intake for Hypequery",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "lint": "eslint --ext .ts \"src/**/*.ts\"",
    "test": "vitest run",
    "types": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hypequery/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hypequery/hypequery.git",
    "directory": "packages/deployment"
  },
  "publishConfig": {
    "access": "public"
  }
}
