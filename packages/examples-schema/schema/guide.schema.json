{
  "$id": "https://hypequery.com/schemas/guide.schema.json",
  "title": "hypequery guide manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "kind": {
      "type": "string",
      "const": "guide"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "clickhouseVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "sqlFiles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "packages": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(@hypequery\\/[a-z0-9-]+|hypequery)$"
      }
    },
    "related": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "leadPages": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\/[a-z0-9-]+(\\/[a-z0-9-]+)*$"
      }
    },
    "functionPages": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "keywords": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "slug",
    "kind",
    "title",
    "outcome",
    "clickhouseVersion",
    "sqlFiles",
    "keywords"
  ],
  "additionalProperties": false
}
