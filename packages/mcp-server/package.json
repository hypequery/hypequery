{
  "name": "@hypequery/mcp",
  "version": "0.5.4",
  "description": "Governed ClickHouse MCP server for semantic metrics, datasets, Claude, Cursor, and AI agents",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "clickhouse",
    "semantic-layer",
    "analytics",
    "query-builder",
    "orm",
    "ai-agents",
    "claude",
    "cursor",
    "typescript"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hypequery-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "test": "npm run test:types && npm run test:unit",
    "test:unit": "vitest run",
    "test:types": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint --ext .ts \"src/**/*.ts\"",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@hypequery/datasets": "^0.13.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypequery/hypequery.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://hypequery.com",
  "bugs": {
    "url": "https://github.com/hypequery/hypequery/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
