{
  "name": "@hypequery/playground",
  "version": "0.1.0",
  "description": "Local hypequery gateway — implements the gateway contract over serve and serves the studio UI",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "lint": "eslint --ext .ts \"src/**/*.ts\"",
    "test": "vitest run",
    "types": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hypequery/serve": "workspace:*",
    "@hypequery/studio": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=22.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hypequery/hypequery.git"
  },
  "homepage": "https://hypequery.com",
  "bugs": {
    "url": "https://github.com/hypequery/hypequery/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
