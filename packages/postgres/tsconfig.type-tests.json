{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "outDir": "./.type-tests",
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/**/*.ts",
    "type-tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
