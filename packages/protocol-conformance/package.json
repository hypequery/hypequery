{
  "name": "@hypequery/protocol-conformance",
  "version": "0.10.3",
  "description": "Cross-language conformance runner for the Hypequery analytics security protocol",
  "keywords": [
    "hypequery",
    "protocol",
    "conformance",
    "analytics",
    "typescript",
    "testing"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "hypequery-protocol-conformance": "./dist/bin/conformance.js",
    "hypequery-protocol-reference-adapter": "./dist/bin/reference-adapter.js"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md"
  ],
  "dependencies": {
    "@hypequery/protocol": "workspace:^"
  },
  "scripts": {
    "build": "node scripts/copy-fixtures.mjs && tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "lint": "eslint --ext .ts \"src/**/*.ts\"",
    "test": "vitest run",
    "types": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypequery/hypequery.git",
    "directory": "packages/protocol-conformance"
  },
  "homepage": "https://hypequery.com",
  "bugs": {
    "url": "https://github.com/hypequery/hypequery/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
