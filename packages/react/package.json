{
  "name": "@hypequery/react",
  "version": "0.7.1",
  "description": "Type-safe React and TanStack Query hooks for ClickHouse analytics, metrics, and datasets",
  "keywords": [
    "react",
    "tanstack-query",
    "clickhouse",
    "analytics",
    "semantic-layer",
    "typescript",
    "query-builder",
    "orm",
    "dashboard",
    "embedded-analytics"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.type-test.*",
    "!dist/**/__tests__/**",
    "!dist/**/tests/**",
    "!dist/**/type-tests/**"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b --force && node scripts/verify-dist.js",
    "types": "tsc -b --noEmit",
    "test:types": "tsc --project tsconfig.type-tests.json",
    "test": "npm run test:types && vitest run",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\"",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.5",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@hypequery/datasets": "workspace:*",
    "@hypequery/serve": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypequery/hypequery.git",
    "directory": "packages/react"
  },
  "homepage": "https://hypequery.com",
  "bugs": {
    "url": "https://github.com/hypequery/hypequery/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
