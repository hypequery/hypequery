# Intentionally present. Hatchling bundles the nearest .gitignore into the
# sdist with no way to suppress it; without this file it walks up and ships the
# monorepo root's instead. See ../reservations/README.md.
dist/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.import_linter_cache/
__pycache__/
reports/
coverage.json
.hypothesis/
# Local state that must never reach an sdist: coverage data holds absolute
# paths from the machine that ran the tests; .env files and databases hold
# credentials and user data.
.coverage
.coverage.*
htmlcov/
.env
.env.*
!.env.example
*.sqlite3
