# Reference only: export these in your shell. This file is not auto-loaded.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
# Optional: cancel queries as a separate user (needs SELECT ON system.processes and KILL QUERY).
# Unset, the query user cancels its own queries and needs GRANT SELECT ON system.processes.
CLICKHOUSE_CONTROL_USERNAME=
CLICKHOUSE_CONTROL_PASSWORD=
HYPEQUERY_DEV_TOKEN=
