{
  "name": "@hypequery-recipes/dictionary-lookups",
  "version": "0.1.1",
  "private": true,
  "description": "Tenant plan and region from a ClickHouse dictionary via dictGet in a hypequery dataset dimension, compared with a relationship JOIN: same rows, timings from system.query_log",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "setup": "npm run build && node dist/setup.js",
    "teardown": "npm run build && node dist/setup.js --teardown",
    "dev": "npm run setup && node dist/recipe.js",
    "capture": "npm run setup && node dist/recipe.js --write",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "@clickhouse/client": "^1.24.1",
    "@hypequery/clickhouse": "workspace:*",
    "@hypequery/datasets": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
