{
  "$schema": "https://hypequery.com/schemas/recipe.schema.json",
  "slug": "grouparray-user-timelines",
  "kind": "recipe",
  "title": "Ordered per-user event timelines in ClickHouse with groupArray, arraySort and groupArraySorted",
  "outcome": "Build each user's event timeline in time order. groupArray's order is not guaranteed; sorting (time, id, value) tuples or groupArraySorted fixes it.",
  "language": "typescript",
  "stack": ["node", "clickhouse"],
  "useCases": ["product-analytics", "user-journeys"],
  "packages": ["@hypequery/clickhouse", "@hypequery/datasets"],
  "keyFile": "src/recipe.ts",
  "datasetFile": "src/dataset.ts",
  "expectedSqlFile": "expected.sql",
  "outputFile": "output.json",
  "env": [
    { "name": "CLICKHOUSE_URL", "description": "ClickHouse HTTP endpoint (default http://localhost:8123)", "required": false },
    { "name": "CLICKHOUSE_USERNAME", "description": "ClickHouse user (default: default)", "required": false },
    { "name": "CLICKHOUSE_PASSWORD", "description": "ClickHouse password (default: hypequery, the seed's password)", "required": false },
    { "name": "CLICKHOUSE_DATABASE", "description": "Database holding the seed tables (default hypequery_examples)", "required": false }
  ],
  "run": { "install": "pnpm install", "dev": "pnpm dev", "test": "pnpm test" },
  "exampleRequest": "node dist/recipe.js --json",
  "related": ["top-n-per-group-limit-by", "retention-cohorts"],
  "leadPages": ["/clickhouse-product-analytics", "/clickhouse-query-builder", "/clickhouse-typescript"],
  "functionPages": ["group-array"],
  "keywords": [
    "clickhouse grouparray order not guaranteed",
    "clickhouse grouparray order by",
    "clickhouse grouparray",
    "clickhouse grouparraysorted",
    "clickhouse arraysort tuple"
  ],
  "minVersion": "2.14.0"
}
