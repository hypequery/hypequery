{
  "name": "@hypequery-recipes/ttl-data-retention",
  "version": "0.1.0",
  "private": true,
  "description": "Per-plan data retention in ClickHouse with table TTL, TTL WHERE and column TTL, applied with MATERIALIZE TTL and tested deterministically against a frozen seed",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "setup": "pnpm build && node dist/setup.js",
    "teardown": "pnpm build && node dist/setup.js --teardown",
    "dev": "pnpm run setup && node dist/recipe.js",
    "capture": "pnpm run setup && node dist/recipe.js --write",
    "test": "pnpm build && vitest run"
  },
  "dependencies": {
    "@clickhouse/client": "^1.24.1",
    "@hypequery/clickhouse": "workspace:*",
    "@hypequery/datasets": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
