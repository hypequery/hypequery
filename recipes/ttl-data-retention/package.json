{
  "name": "@hypequery-recipes/ttl-data-retention",
  "version": "0.1.5",
  "private": true,
  "description": "Per-plan data retention in ClickHouse with table TTL, TTL WHERE and column TTL, applied with MATERIALIZE TTL and tested deterministically against a frozen seed",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "setup": "npm run build && node dist/setup.js",
    "teardown": "npm run build && node dist/setup.js --teardown",
    "dev": "npm run setup && node dist/recipe.js",
    "capture": "npm run setup && node dist/recipe.js --write",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "@clickhouse/client": "^1.25.0",
    "@hypequery/clickhouse": "workspace:*",
    "@hypequery/datasets": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
