{
  "$schema": "https://hypequery.com/schemas/recipe.schema.json",
  "slug": "ttl-data-retention",
  "kind": "recipe",
  "title": "Per-plan data retention in ClickHouse with TTL and a typed dataset",
  "outcome": "Expire free-plan events after 30 days and starter events after 180 with TTL WHERE, clear a column with column TTL, and pin the result on any run date.",
  "language": "typescript",
  "stack": ["node", "clickhouse"],
  "useCases": ["saas-analytics", "multi-tenant"],
  "packages": ["@hypequery/datasets", "@hypequery/clickhouse"],
  "keyFile": "sql/setup.sql",
  "datasetFile": "src/dataset.ts",
  "expectedSqlFile": "expected.sql",
  "outputFile": "output.json",
  "env": [
    { "name": "CLICKHOUSE_URL", "description": "ClickHouse HTTP endpoint (default http://localhost:8123)", "required": false },
    { "name": "CLICKHOUSE_USERNAME", "description": "ClickHouse user (default: default)", "required": false },
    { "name": "CLICKHOUSE_PASSWORD", "description": "ClickHouse password (default: hypequery, the seed's password)", "required": false },
    { "name": "CLICKHOUSE_DATABASE", "description": "Database holding the seed tables (default hypequery_examples)", "required": false }
  ],
  "run": { "install": "pnpm install", "dev": "pnpm dev", "test": "pnpm test" },
  "exampleRequest": "node dist/recipe.js --json",
  "related": ["replacingmergetree-upserts", "multi-tenant-embedded-analytics"],
  "leadPages": ["/clickhouse-multi-tenant-analytics", "/clickhouse-saas-analytics", "/clickhouse-schema", "/clickhouse-time-series"],
  "functionPages": ["to-date"],
  "keywords": [
    "clickhouse ttl",
    "clickhouse ttl where",
    "clickhouse column ttl",
    "clickhouse materialize ttl",
    "clickhouse data retention"
  ],
  "minVersion": "2.14.0"
}
