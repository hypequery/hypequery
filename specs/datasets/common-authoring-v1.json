{
  "kind": "hypequery-deployment",
  "version": 2,
  "datasets": [
    {
      "name": "orders",
      "source": "analytics.orders",
      "tenant": {
        "kind": "required",
        "field": "tenant_id"
      },
      "dimensions": [
        {
          "name": "amount",
          "type": "number",
          "source": {
            "kind": "column",
            "column": "amount"
          },
          "filterable": true,
          "groupable": true
        },
        {
          "name": "createdAt",
          "type": "timestamp",
          "source": {
            "kind": "column",
            "column": "createdAt"
          },
          "filterable": true,
          "groupable": true
        },
        {
          "name": "status",
          "type": "string",
          "source": {
            "kind": "column",
            "column": "status"
          },
          "filterable": true,
          "groupable": true
        }
      ],
      "measures": [
        {
          "name": "paidRevenue",
          "aggregation": "sum",
          "field": "amount",
          "filters": [
            {
              "kind": "comparison",
              "operator": "eq",
              "left": {
                "kind": "reference",
                "name": "status"
              },
              "right": {
                "kind": "literal",
                "value": "paid"
              }
            }
          ]
        },
        {
          "name": "revenue",
          "aggregation": "sum",
          "field": "amount",
          "filters": []
        }
      ],
      "filters": [
        {
          "name": "amount",
          "field": "amount",
          "operators": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "notIn",
            "between",
            "like"
          ]
        },
        {
          "name": "createdAt",
          "field": "createdAt",
          "operators": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "notIn",
            "between",
            "like"
          ]
        },
        {
          "name": "status",
          "field": "status",
          "operators": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "notIn",
            "between",
            "like"
          ]
        }
      ],
      "relationships": [],
      "timeField": "createdAt"
    }
  ]
}
