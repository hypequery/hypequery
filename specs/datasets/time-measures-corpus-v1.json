  "datasets": {
    "windows": {
      "source": "hq_corpus_windows",
      "timeKey": "time",
      "tenantKey": "tenant",
      "dimensions": {
        "time": {
          "type": "timestamp",
          "column": "event_at"
        },
        "group": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "measures": {
        "revenue": {
          "aggregation": "sum",
          "field": "value"
        },
        "users": {
          "aggregation": "countDistinct",
          "field": "user"
        },
        "count": {
          "aggregation": "count",
          "field": "user"
        },
        "average": {
          "aggregation": "avg",
          "field": "value"
        },
        "minimum": {
          "aggregation": "min",
          "field": "value"
        },
        "maximum": {
          "aggregation": "max",
          "field": "value"
        },
        "trailingUsers": {
          "kind": "window",
          "measure": "users",
          "trailing": {
            "amount": 3,
            "unit": "day"
          }
        },
        "trailingRevenue": {
          "kind": "window",
          "measure": "revenue",
          "trailing": {
            "amount": 3,
            "unit": "day"
          }
        },
        "trailingAverage": {
          "kind": "window",
          "measure": "average",
          "trailing": {
            "amount": 3,
            "unit": "day"
          }
        },
        "hourlyRevenue": {
          "kind": "window",
          "measure": "revenue",
          "trailing": {
            "amount": 120,
            "unit": "minute"
          }
        },
        "monthRevenue": {
          "kind": "window",
          "measure": "revenue",
          "toDate": "month"
        },
        "weekRevenue": {
          "kind": "window",
          "measure": "revenue",
          "toDate": "week"
        },
        "yearRevenue": {
          "kind": "window",
          "measure": "revenue",
          "toDate": "year"
        },
        "totalRevenue": {
          "kind": "window",
          "measure": "revenue",
          "cumulative": true
        },
        "totalCount": {
          "kind": "window",
          "measure": "count",
          "cumulative": true
        },
        "totalMinimum": {
          "kind": "window",
          "measure": "minimum",
          "cumulative": true
        },
        "totalMaximum": {
          "kind": "window",
          "measure": "maximum",
          "cumulative": true
        },
        "delta": {
          "kind": "derived",
          "formula": {
            "op": "subtract",
            "args": [
              "revenue",
              "trailingRevenue"
            ]
          }
        }
      }
    },
    "shifts": {
      "source": "hq_corpus_shifts",
      "timeKey": "time",
      "tenantKey": "tenant",
      "dimensions": {
        "time": {
          "type": "timestamp",
          "column": "event_at"
        },
        "group": {
          "type": "string"
        },
        "user": {
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "measures": {
        "revenue": {
          "aggregation": "sum",
          "field": "value"
        },
        "count": {
          "aggregation": "count",
          "field": "user"
        },
        "distinct": {
          "aggregation": "countDistinct",
          "field": "user"
        },
        "average": {
          "aggregation": "avg",
          "field": "value"
        },
        "priorRevenue": {
          "kind": "shift",
          "measure": "revenue",
          "interval": {
            "amount": 1,
            "unit": "year"
          }
        },
        "priorCount": {
          "kind": "shift",
          "measure": "count",
          "interval": {
            "amount": 1,
            "unit": "year"
          }
        },
        "priorDistinct": {
          "kind": "shift",
          "measure": "distinct",
          "interval": {
            "amount": 1,
            "unit": "year"
          }
        },
        "priorAverage": {
          "kind": "shift",
          "measure": "average",
          "interval": {
            "amount": 1,
            "unit": "year"
          }
        },
        "lastQuarter": {
          "kind": "shift",
          "measure": "revenue",
          "interval": {
            "amount": 1,
            "unit": "quarter"
          }
        },
        "rollingRevenue": {
          "kind": "window",
          "measure": "revenue",
          "trailing": {
            "amount": 2,
            "unit": "month"
          }
        },
        "growth": {
          "kind": "derived",
          "formula": {
            "op": "divide",
            "args": [
              {
                "op": "subtract",
                "args": [
                  "revenue",
                  "priorRevenue"
                ]
              },
              {
                "op": "nullIfZero",
                "args": [
                  "priorRevenue"
                ]
              }
            ]
          }
        },
        "rollingDelta": {
          "kind": "derived",
          "formula": {
            "op": "subtract",
            "args": [
              "rollingRevenue",
              "priorRevenue"
            ]
          }
        }
      }
    },
    "calendar": {
      "source": "hq_corpus_calendar",
      "timeKey": "time",
      "dimensions": {
        "time": {
          "type": "timestamp"
        },
        "group": {
          "type": "string"
        }
      },
      "measures": {
        "revenue": {
          "aggregation": "sum",
          "field": "value"
        },
        "priorYear": {
          "kind": "shift",
          "measure": "revenue",
          "interval": {
            "amount": 1,
            "unit": "year"
          }
        },
        "priorMonth": {
          "kind": "shift",
          "measure": "revenue",
          "interval": {
            "amount": 1,
            "unit": "month"
          }
        }
      }
    }
  },
  "cases": [
    {
      "name": "trailing windows reaggregate, fill gaps and look before the range",
      "dataset": "windows",
      "tenant": "a",
      "query": {
        "by": "day",
        "measures": [
          "trailingUsers",
          "trailingRevenue",
          "trailingAverage",
          "revenue",
          "count"
        ],
        "filters": [
          {
            "field": "time",
            "operator": "gte",
            "value": "2026-01-02"
          },
          {
            "field": "time",
            "operator": "lt",
            "value": "2026-01-06"
          },
          {
            "field": "group",
            "operator": "eq",
            "value": "x"
          }
        ]
      },
      "expected": {
        "rows": [
          {
            "period": "2026-01-02 00:00:00",
            "trailingUsers": "1",
            "trailingRevenue": "32",
            "trailingAverage": "10.666666666666666",
            "revenue": "20",
            "count": "1"
          },
          {
            "period": "2026-01-03 00:00:00",
            "trailingUsers": "1",
            "trailingRevenue": "30",
            "trailingAverage": "15",
            "revenue": null,
            "count": "0"
          },
          {
            "period": "2026-01-04 00:00:00",
            "trailingUsers": "2",
            "trailingRevenue": "60",
            "trailingAverage": "30",
            "revenue": "40",
            "count": "1"
          },
          {
            "period": "2026-01-05 00:00:00",
            "trailingUsers": "2",
            "trailingRevenue": "47",
            "trailingAverage": "23.5",
            "revenue": "7",
