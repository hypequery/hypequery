        "type": "boolean"
      },
      "hint": {
        "type": "string"
      }
    }
  },
  "getBusinessContextTool": {
    "name": "get_business_context",
    "title": "Get business context",
    "description": "Get the business context for these datasets: what the business does, KPI definitions, the glossary of business terms, reporting conventions (currency, time zone, fiscal year) and known data caveats. Read it before interpreting or presenting numbers.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    },
    "outputSchema": {
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "businessContext": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "summary": {
                  "type": "string"
                },
                "industry": {
                  "type": "string"
                },
                "businessModel": {
                  "type": "string"
                },
                "customers": {
                  "type": "string"
                },
                "audience": {
                  "type": "string"
                },
                "goals": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "kpis": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "definition": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "definition"
                    ]
                  }
                },
                "glossary": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "term": {
                        "type": "string"
                      },
                      "meaning": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "term",
                      "meaning"
                    ]
                  }
                },
                "conventions": {
                  "type": "string"
                },
                "caveats": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "required": [
            "businessContext"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "error": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "MCP_INVALID_ARGUMENTS",
                    "MCP_NOT_FOUND",
                    "MCP_UNKNOWN_TOOL",
                    "MCP_UNAUTHORIZED",
                    "MCP_STALE_CONTRACT",
                    "MCP_REQUEST_CANCELLED",
                    "MCP_QUERY_TIMEOUT",
                    "MCP_RESULT_TOO_LARGE",
                    "MCP_CATALOG_TOO_LARGE",
                    "MCP_RATE_LIMITED",
                    "MCP_EXECUTION_FAILED"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "correctable_input",
                    "unauthorized",
                    "stale_contract",
                    "budget",
                    "internal"
                  ]
                },
                "retryable": {
                  "type": "boolean"
                },
                "correctable": {
                  "type": "boolean"
                },
                "retryAfterSeconds": {
                  "type": "number",
                  "minimum": 0
                },
                "relist": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "string"
                },
                "hint": {
                  "type": "string"
                },
                "docsUrl": {
                  "type": "string"
                },
                "requestId": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "category",
                "message",
                "retryable",
                "correctable"
              ]
            }
          },
          "required": [
            "error"
          ]
        }
      ]
    },
    "annotations": {
      "title": "Get business context",
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
