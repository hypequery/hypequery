{
  "listDatasetsDescription": "List all available datasets in the semantic layer, with the business context (KPIs, glossary, conventions, caveats) to interpret them",
  "listDatasetsBusinessContextSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "summary": {
        "type": "string"
      },
