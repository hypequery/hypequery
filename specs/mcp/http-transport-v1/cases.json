      "description": "An allowed Origin is served, and the page may read the reply and the session id.",
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/mcp",
            "headers": {
              "host": "mcp.example.test",
              "accept": "application/json, text/event-stream",
              "content-type": "application/json",
              "authorization": "Bearer fixture-static-key-0123456789abcdef",
              "origin": "https://app.example.test"
            },
            "body": {
              "jsonrpc": "2.0",
              "id": 1,
              "method": "initialize",
              "params": {
                "protocolVersion": "2025-06-18",
                "capabilities": {},
                "clientInfo": {
                  "name": "fixture-client",
                  "version": "1.0.0"
                }
              }
            }
          },
          "expect": {
            "status": 200,
            "session": true,
            "headers": {
              "access-control-allow-origin": "https://app.example.test",
              "access-control-expose-headers": "mcp-session-id, www-authenticate"
            }
          }
        }
      ]
    },
    {
      "id": "static-preflight-allowed",
      "profile": "static",
      "description": "A browser preflight from an allowed origin is answered before any credential.",
      "steps": [
        {
          "request": {
            "method": "OPTIONS",
            "path": "/mcp",
            "headers": {
              "host": "mcp.example.test",
              "origin": "https://app.example.test",
              "access-control-request-method": "POST",
              "access-control-request-headers": "authorization, content-type"
            }
          },
          "expect": {
            "status": 204,
            "headers": {
              "access-control-allow-origin": "https://app.example.test",
              "access-control-allow-methods": "GET, POST, DELETE, OPTIONS",
              "access-control-allow-headers": "authorization, content-type, accept, mcp-protocol-version, mcp-session-id, last-event-id",
              "access-control-max-age": "600"
            }
          }
        }
      ]
    },
    {
      "id": "static-preflight-origin-refused",
