{
  "version": 1,
  "profiles": {
    "static": {
      "path": "/mcp",
      "allowedHosts": [
        "mcp.example.test"
      ],
      "allowedOrigins": [
        "https://app.example.test"
      ],
      "auth": {
        "kind": "static-key",
        "key": "fixture-static-key-0123456789abcdef"
      }
    },
    "oauth": {
      "path": "/mcp",
      "allowedHosts": [
        "mcp.example.test"
      ],
      "allowedOrigins": [
        "https://app.example.test"
      ],
      "auth": {
        "kind": "jwt",
        "secret": "hypequery-mcp-http-fixture-secret-0123456789abcdef",
        "algorithm": "HS256",
        "issuer": "https://auth.example.test",
        "audience": "https://mcp.example.test/mcp",
        "tenantClaim": "org_id"
      },
      "oauth": {
        "resource": "https://mcp.example.test/mcp",
        "authorizationServers": [
          "https://auth.example.test"
        ],
        "scopesSupported": [
          "analytics:read"
        ],
        "requiredScopes": [
          "analytics:read"
        ]
      }
    }
  },
  "cases": [
    {
      "id": "static-initialize",
      "profile": "static",
      "description": "The configured key opens a session.",
      "steps": [
        {
          "request": {
            "method": "POST",
            "path": "/mcp",
            "headers": {
              "host": "mcp.example.test",
              "accept": "application/json, text/event-stream",
              "content-type": "application/json",
              "authorization": "Bearer fixture-static-key-0123456789abcdef"
            },
            "body": {
              "jsonrpc": "2.0",
              "id": 1,
              "method": "initialize",
              "params": {
                "protocolVersion": "2025-06-18",
                "capabilities": {},
                "clientInfo": {
                  "name": "fixture-client",
                  "version": "1.0.0"
                }
              }
            }
          },
          "expect": {
            "status": 200,
            "session": true
          }
        }
      ]
    },
    {
      "id": "static-session-roundtrip",
