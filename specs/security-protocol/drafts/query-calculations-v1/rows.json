  "dataset": {
    "name": "orders", "timeKey": "created_at", "tenantKey": "tenant",
    "dimensions": ["created_at", "country", "channel", "user_id"],
    "measures": {
      "revenue": "sum(amount)", "orders": "count(id)", "users": "countDistinct(user_id)",
      "avg_order": "avg(amount)", "largest": "max(amount)"
    }
  },
  "range": ["2026-01-01T00:00:00Z", "2026-05-01T00:00:00Z"],
  "outline": [
    "filter: web_revenue by country; web users (countDistinct) by month",
    "shift: revenue by month, 1 year back (2025 rows), Feb is empty and gap-filled",
    "window: trailing 2 month, toDate year, cumulative on revenue and on a filter calculation",
    "formula: aov = revenue / nullIfZero(orders); nested reference to aov",
    "compare previousPeriod by month: Feb shows previous=Jan, change_pct NULL for Mar (previous 0)",
    "compare previousYear by quarter",
    "rank revenue by country within period; ties (FR and GB both 45 in March)",
    "share additive: revenue by country of period; share non-additive: users by country of [] (u1 in US, DE, FR)",
    "limitBy 2 by period ordered by revenue desc",
    "other: top 2 countries by revenue + Other, users (countDistinct) exact in the Other bucket; NULL country lands in Other",
    "tenant b's row never contributes"
  ]
}
