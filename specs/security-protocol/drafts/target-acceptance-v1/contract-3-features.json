  {
    "id": "window-and-shift-measures",
    "contract": {
      "kind": "hypequery-deployment",
      "version": 3,
      "datasets": [
        {
          "name": "orders",
          "source": "orders",
          "tenant": {
            "kind": "not-required"
          },
          "dimensions": [
            {
              "name": "tier",
              "type": "string",
              "source": {
                "kind": "column",
                "column": "tier"
              },
              "filterable": true,
              "groupable": true
            },
            {
              "name": "status",
              "type": "string",
              "source": {
                "kind": "column",
                "column": "status"
              },
              "filterable": true,
              "groupable": true
            },
            {
              "name": "amount",
              "type": "number",
              "source": {
                "kind": "column",
                "column": "amount"
              },
              "filterable": true,
              "groupable": true
            },
            {
              "name": "createdAt",
              "type": "timestamp",
              "source": {
                "kind": "column",
                "column": "created_at"
              },
              "filterable": true,
              "groupable": true
            }
          ],
          "measures": [
            {
              "name": "revenue",
              "aggregation": "sum",
              "field": "amount",
              "filters": []
            },
            {
              "kind": "window",
              "requiresTimeRange": true,
              "name": "revenue7d",
              "measure": "revenue",
              "trailing": {
                "amount": 7,
                "unit": "day"
              }
            },
            {
              "kind": "window",
              "requiresTimeRange": true,
              "name": "revenueMtd",
              "measure": "revenue",
              "toDate": "month"
            },
            {
              "kind": "window",
              "requiresTimeRange": true,
              "name": "revenueRunning",
              "measure": "revenue",
              "cumulative": true
            },
            {
              "kind": "shift",
              "requiresTimeRange": true,
              "name": "revenuePriorYear",
              "measure": "revenue",
              "interval": {
                "amount": 1,
                "unit": "year"
              }
            },
            {
              "kind": "derived",
              "name": "revenueGrowth",
              "uses": [
                {
                  "alias": "now",
                  "measure": "revenue"
                },
                {
                  "alias": "before",
                  "measure": "revenuePriorYear"
                }
              ],
              "expression": {
                "kind": "binary",
                "operator": "divide",
                "left": {
                  "kind": "binary",
                  "operator": "subtract",
                  "left": {
                    "kind": "reference",
                    "name": "now"
                  },
                  "right": {
                    "kind": "reference",
                    "name": "before"
                  }
                },
                "right": {
                  "kind": "call",
                  "function": "nullIfZero",
                  "args": [
                    {
                      "kind": "reference",
                      "name": "before"
                    }
                  ]
                }
              }
            }
          ],
          "allowedFilters": [
            {
              "name": "status",
              "field": "status",
              "operators": [
                "eq",
                "in"
              ]
            }
          ],
          "segments": [],
          "relationships": [],
          "timeField": "created_at"
        }
      ]
    },
    "expected": [
      {
        "dataset": "orders",
        "features": [
          "windowMeasures",
          "shiftMeasures"
        ]
      }
    ]
  },
