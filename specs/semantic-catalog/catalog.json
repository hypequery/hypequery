  "orders": {
    "name": "orders",
    "source": "orders",
    "tenantKey": "tenant_id",
    "timeKey": "created_at",
    "dimensions": {
      "id": {
        "type": "string",
        "filterable": true,
        "groupable": true
      },
      "customerId": {
        "type": "string",
        "column": "customer_id",
        "filterable": true,
        "groupable": true
      },
      "status": {
        "type": "string",
        "label": "Status",
        "filterable": false,
        "groupable": true
      },
      "createdAt": {
        "type": "timestamp",
        "column": "created_at",
        "filterable": true,
        "groupable": true
      },
      "amount": {
        "type": "number",
        "filterable": true,
        "groupable": true
      }
    },
    "measures": {
      "revenue": {
        "aggregation": "sum",
        "field": "amount",
        "label": "Revenue",
        "filterCount": 0
      },
      "orderCount": {
        "aggregation": "count",
        "field": "id",
        "filterCount": 0
      },
      "uniqueCustomers": {
        "aggregation": "countDistinct",
        "field": "customerId",
        "filterCount": 0
      },
      "topStatus": {
        "aggregation": "argMax",
        "field": "status",
        "argField": "amount",
        "filterCount": 0
      },
      "p95Amount": {
        "aggregation": "percentile",
        "field": "amount",
        "level": 0.95,
        "filterCount": 0
      },
      "paidRevenue": {
        "aggregation": "sum",
        "field": "amount",
        "filterCount": 1
      }
    },
    "metrics": {},
    "filters": {
      "status": {
        "field": "status",
        "operators": [
          "eq",
          "in"
        ],
        "valueType": "string"
      }
    },
    "relationships": {
      "customer": {
        "kind": "belongsTo",
        "target": "customers",
        "from": "customerId",
        "to": "id",
        "queryable": true,
        "fields": [
          "customer.id",
          "customer.country",
          "customer.tier"
        ],
        "groupableFields": [
          "customer.id",
          "customer.country"
        ]
      },
      "primaryContact": {
        "kind": "hasOne",
        "target": "customers",
        "from": "id",
        "to": "id",
        "queryable": true,
        "fields": [
          "primaryContact.id",
          "primaryContact.country",
          "primaryContact.tier"
        ],
        "groupableFields": [
          "primaryContact.id",
          "primaryContact.country"
        ]
      },
      "relatedCustomers": {
        "kind": "hasMany",
        "target": "customers",
        "from": "id",
        "to": "id",
        "queryable": false,
        "fields": [],
        "groupableFields": []
      }
    },
    "limits": {
      "maxDimensions": 5,
      "maxFilters": 10,
      "maxResultSize": 1000
    },
    "requiresTenant": true,
    "supportedGrains": [
      "minute",
      "hour",
      "day",
      "week",
      "month",
      "quarter",
      "year"
    ],
    "orderableFields": [
      "id",
      "customerId",
      "status",
      "createdAt",
      "amount",
      "revenue",
      "orderCount",
      "uniqueCustomers",
      "topStatus",
      "p95Amount",
      "paidRevenue",
      "customer.id",
      "customer.country",
      "customer.tier",
      "primaryContact.id",
      "primaryContact.country",
      "primaryContact.tier",
      "period"
    ],
    "maxLimit": 1000
  }
