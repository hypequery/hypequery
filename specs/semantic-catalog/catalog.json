  "orders": {
    "name": "orders",
    "source": "orders",
    "tenantKey": "tenant_id",
    "timeKey": "created_at",
    "dimensions": {
      "id": {
        "type": "string",
        "filterable": true,
        "groupable": true
      },
      "customerId": {
        "type": "string",
        "column": "customer_id",
        "filterable": true,
        "groupable": true
      },
      "status": {
        "type": "string",
        "label": "Status",
        "filterable": false,
        "groupable": true
      },
      "createdAt": {
        "type": "timestamp",
        "column": "created_at",
        "filterable": true,
        "groupable": true
      },
      "amount": {
        "type": "number",
        "filterable": true,
        "groupable": true
      }
    },
    "measures": {
      "revenue": {
        "aggregation": "sum",
        "field": "amount",
        "label": "Revenue",
        "filterCount": 0
      },
      "orderCount": {
        "aggregation": "count",
        "field": "id",
        "filterCount": 0
      },
      "uniqueCustomers": {
        "aggregation": "countDistinct",
        "field": "customerId",
        "filterCount": 0
      },
      "approxCustomers": {
        "aggregation": "approxCountDistinct",
        "field": "customerId",
        "filterCount": 0,
        "approximate": true
      },
      "topStatus": {
        "aggregation": "argMax",
        "field": "status",
        "argField": "amount",
        "filterCount": 0
      },
      "p95Amount": {
        "aggregation": "percentile",
        "field": "amount",
        "level": 0.95,
        "filterCount": 0
      },
      "paidRevenue": {
        "aggregation": "sum",
        "field": "amount",
        "filterCount": 1
      },
      "rollingRevenue": {
        "aggregation": "sum",
        "field": "amount",
        "label": "Rolling revenue",
        "filterCount": 0,
        "kind": "window",
        "measure": "revenue",
        "requiresTimeRange": true,
        "trailing": {
          "amount": 7,
          "unit": "day"
        },
        "supportedGrains": [
          "hour",
          "day",
          "week"
        ]
      },
      "monthToDateRevenue": {
        "aggregation": "sum",
        "field": "amount",
        "filterCount": 0,
        "kind": "window",
        "measure": "revenue",
        "requiresTimeRange": true,
        "toDate": "month",
        "supportedGrains": [
          "hour",
          "day"
        ]
      },
      "runningOrders": {
        "aggregation": "count",
        "field": "id",
        "filterCount": 0,
        "kind": "window",
        "measure": "orderCount",
        "requiresTimeRange": true,
        "cumulative": true,
        "supportedGrains": [
          "minute",
          "hour",
          "day",
          "week",
          "month",
          "quarter",
          "year"
        ]
      },
      "revenueLastWeek": {
        "aggregation": "sum",
        "field": "amount",
        "filterCount": 0,
        "kind": "shift",
        "measure": "revenue",
        "interval": {
          "amount": 7,
          "unit": "day"
        },
        "requiresTimeRange": true,
        "supportedGrains": [
          "minute",
          "hour",
          "day",
          "week"
        ]
      }
    },
    "derivedMeasures": {
      "weekOverWeek": {
        "uses": [
          {
            "alias": "revenue",
            "measure": "revenue"
          },
          {
            "alias": "revenueLastWeek",
            "measure": "revenueLastWeek"
          }
        ],
        "expression": {
          "kind": "binary",
          "operator": "divide",
          "left": {
            "kind": "reference",
            "name": "revenue"
          },
          "right": {
            "kind": "reference",
            "name": "revenueLastWeek"
          }
        },
        "requiresTimeRange": true,
        "supportedGrains": [
          "minute",
          "hour",
          "day",
          "week"
        ]
      }
    },
    "metrics": {},
    "segments": {
      "paid": {
        "label": "Paid orders"
      }
    },
    "filters": {
      "status": {
        "field": "status",
        "operators": [
          "eq",
          "in"
        ],
        "valueType": "string"
      }
    },
    "relationships": {
      "customer": {
        "kind": "belongsTo",
        "target": "customers",
        "from": "customerId",
        "to": "id",
        "queryable": true,
        "fields": [
          "customer.id",
          "customer.country",
          "customer.tier"
        ],
        "groupableFields": [
          "customer.id",
          "customer.country"
        ]
      },
      "primaryContact": {
        "kind": "hasOne",
        "target": "customers",
        "from": "id",
        "to": "id",
        "queryable": true,
        "fields": [
          "primaryContact.id",
          "primaryContact.country",
          "primaryContact.tier"
        ],
        "groupableFields": [
          "primaryContact.id",
          "primaryContact.country"
        ],
        "measures": {
          "primaryContact.customerCount": {
            "aggregation": "count",
            "field": "id",
            "filterCount": 0
          }
        }
      },
      "relatedCustomers": {
        "kind": "hasMany",
        "target": "customers",
        "from": "id",
        "to": "id",
        "queryable": false,
        "fields": [],
        "groupableFields": []
      }
    },
    "limits": {
      "maxDimensions": 5,
      "maxFilters": 10,
      "maxResultSize": 1000
    },
    "requiresTenant": true,
    "supportedGrains": [
      "minute",
      "hour",
      "day",
      "week",
      "month",
      "quarter",
      "year"
    ],
    "orderableFields": [
      "id",
      "customerId",
      "status",
      "createdAt",
      "amount",
      "revenue",
      "orderCount",
      "uniqueCustomers",
      "approxCustomers",
      "topStatus",
      "p95Amount",
      "paidRevenue",
      "rollingRevenue",
      "monthToDateRevenue",
      "runningOrders",
      "revenueLastWeek",
      "weekOverWeek",
      "customer.id",
      "customer.country",
      "customer.tier",
      "primaryContact.id",
      "primaryContact.country",
      "primaryContact.tier",
      "primaryContact.customerCount",
      "period"
    ],
    "maxLimit": 1000
  }
}
