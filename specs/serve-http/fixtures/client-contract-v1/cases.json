{
  "version": 1,
  "app": {
    "credential": "reader",
    "basePath": "/api",
    "mountPath": "/edge",
    "dataset": {
      "name": "orders",
      "source": "private_orders",
      "description": "One row per order.",
      "timeKey": "private_created_at",
      "timeGrains": [
        "month",
        "day"
      ],
      "dimensions": {
        "country": {
          "type": "string",
          "column": "private_country",
          "label": "  Country  "
        },
        "amount": {
          "type": "number",
          "column": "private_amount"
        },
        "paid": {
          "type": "boolean",
          "column": "private_paid"
        },
        "createdAt": {
          "type": "timestamp",
          "column": "private_created_at",
          "groupable": false
        }
      },
      "measures": {
        "revenue": {
          "aggregation": "sum",
          "field": "amount",
          "description": "Gross revenue"
        },
        "orders": {
          "aggregation": "count",
          "field": "country"
        },
        "latestCountry": {
          "aggregation": "max",
          "field": "country"
        },
        "average": {
          "divide": [
            "revenue",
            "orders"
          ]
        }
      },
      "filters": {
        "country": {
          "field": "country",
          "operators": [
            "like",
            "eq",
            "in"
          ]
        },
        "minimumAmount": {
          "field": "amount",
          "operators": [
            "gte",
            "like"
          ]
        },
        "paid": {
          "field": "paid"
        },
        "closed": {
          "field": "country",
          "operators": []
        }
      },
      "limits": {
        "maxResultSize": 500,
        "maxMeasures": 10
      }
    },
    "metric": {
      "name": "totalRevenue",
      "measure": "revenue"
    },
    "rows": [
      {
        "country": "US",
        "revenue": 10,
        "orders": 1,
        "latestCountry": "US",
        "totalRevenue": 10
      },
      {
        "country": "DE",
        "revenue": 20,
        "orders": 2,
        "latestCountry": "DE",
        "totalRevenue": 20
      },
      {
        "country": "FR",
        "revenue": 30,
        "orders": 3,
        "latestCountry": "FR",
        "totalRevenue": 30
      }
    ]
  },
