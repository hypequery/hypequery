{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "tsconfig*.json",
        "src/**/*.tsx",
        "src/**/*.ts",
        "src/**/*.json",
        "src/**/*.d.ts",
        "codegen/**/*.ts",
        "**/__snapshots__/**",
        "test/**/*.ts",
        "test/**/*.tsx",
        "type-tests/**/*.ts",
        "type-tests/**/*.tsx",
        "type-tests/**/*.d.ts",
        "$TURBO_ROOT$/specs/security-protocol/**",
        "$TURBO_ROOT$/specs/cloud-api/**",
        "$TURBO_ROOT$/specs/datasets/**",
        "$TURBO_ROOT$/specs/serve-http/**",
        "$TURBO_ROOT$/specs/semantic-catalog/**",
        "$TURBO_ROOT$/specs/mcp/**"
      ]
    },
    "@hypequery/cli#test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/website-next/docs/**/telemetry.mdx",
        "$TURBO_ROOT$/website-next/docs/cloud/cli-operations.mdx",
        "$TURBO_ROOT$/specs/cloud-api/operations-v1.json"
      ]
    },
    "@hypequery/examples-schema#lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/*/example.json",
        "$TURBO_ROOT$/examples/*/README.md",
        "$TURBO_ROOT$/examples/*/**/*.ts",
        "$TURBO_ROOT$/examples/*/**/*.tsx",
        "$TURBO_ROOT$/recipes/*/recipe.json",
        "$TURBO_ROOT$/recipes/*/README.md",
        "$TURBO_ROOT$/recipes/*/**/*.ts",
        "$TURBO_ROOT$/recipes/*/**/*.sql",
        "$TURBO_ROOT$/recipes/*/**/*.json",
        "$TURBO_ROOT$/examples/*/screenshot.png",
        "$TURBO_ROOT$/website-next/src/data/examples-registry.json",
        "$TURBO_ROOT$/website-next/src/app/*/page.tsx"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate-types": {
      "cache": false,
      "dependsOn": [
        "build"
      ]
    },
    "types": {
      "dependsOn": [],
      "outputs": []
    }
  }
}
