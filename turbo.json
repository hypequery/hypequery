{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "tsconfig*.json",
        "src/**/*.tsx",
        "src/**/*.ts",
        "src/**/*.json",
        "src/**/*.d.ts",
        "test/**/*.ts",
        "test/**/*.tsx",
        "type-tests/**/*.ts",
        "type-tests/**/*.tsx",
        "type-tests/**/*.d.ts",
        "$TURBO_ROOT$/specs/security-protocol/**",
        "$TURBO_ROOT$/specs/datasets/**",
        "$TURBO_ROOT$/specs/serve-http/**",
        "$TURBO_ROOT$/specs/semantic-catalog/**"
      ]
    },
    "@hypequery/cli#test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/website-next/docs/telemetry.mdx"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate-types": {
      "cache": false,
      "dependsOn": [
        "build"
      ]
    },
    "types": {
      "dependsOn": [],
      "outputs": []
    }
  }
}
