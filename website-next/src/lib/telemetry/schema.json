  "VALUE_FORMATS": {
    "uuid": {
      "pattern": {
        "source": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "flags": "i"
      },
      "maxLength": 36,
      "description": "Random UUID v4 (36 characters)"
    },
    "hash": {
      "pattern": {
        "source": "^[0-9a-f]{64}$",
        "flags": ""
      },
      "maxLength": 64,
      "description": "64 lowercase hexadecimal characters (salted SHA-256)"
    },
    "version": {
      "pattern": {
        "source": "^(?:unknown|\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}(?:-(?:canary|alpha|beta|rc|dev|snapshot)(?:[.-]\\d{1,14})*)?)$",
        "flags": ""
      },
      "maxLength": 80,
      "description": "Exact major.minor.patch (1–3 digits per component); optional canary/alpha/beta/rc/dev/snapshot suffix with 1–14 digit numeric components, or `unknown`; at most 80 characters"
    },
    "node_version": {
      "pattern": {
        "source": "^(?:unknown|\\d{1,3}\\.\\d{1,3})$",
        "flags": ""
      },
      "maxLength": 80,
      "description": "Numeric major.minor (1–3 digits per component), or `unknown`"
    },
    "major_version": {
      "pattern": {
        "source": "^(?:unknown|\\d{1,3})$",
        "flags": ""
      },
      "maxLength": 80,
      "description": "Numeric major (1–3 digits), or `unknown`"
    }
  }
